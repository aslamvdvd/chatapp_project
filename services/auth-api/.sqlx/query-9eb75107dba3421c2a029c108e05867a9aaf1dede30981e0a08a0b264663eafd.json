{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT u.id, u.username, u.email, \n                   CONCAT(u.first_name, ' ', u.last_name) as \"full_name!\"\n            FROM users u\n            INNER JOIN friends f ON u.id = f.friend_id\n            WHERE f.user_id = $1\n            ORDER BY u.username\n            LIMIT $2 OFFSET $3\n            ",
